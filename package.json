{
  "name": "recipes-app",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:unit": "deno test --node-modules-dir=auto --allow-env --allow-net --allow-read supabase/functions/_shared",
    "test:integration": "deno test --node-modules-dir=auto -A supabase/functions/_integration",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^2.120.0"
  }
}
