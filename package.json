{
  "name": "recipes-app",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:unit": "deno test --node-modules-dir=auto --allow-env --allow-net --allow-read supabase/functions/_shared",
    "test:integration": "deno test --node-modules-dir=auto -A supabase/functions/_integration",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "app:dev": "npm --prefix app run dev",
    "app:test": "npm --prefix app test",
    "app:e2e": "npm --prefix app run e2e",
    "fb-helper": "deno run --node-modules-dir=auto -A tools/fb-helper/main.ts",
    "fb-helper:login": "deno run --node-modules-dir=auto -A tools/fb-helper/main.ts --login",
    "test:fb-helper": "deno test --node-modules-dir=auto tools/fb-helper"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "supabase": "^2.120.0"
  }
}
